{
  "manifest_version": 3,
  "name": "Ctrl+Z Eats",
  "short_name": "Ctrl+Z Eats",
  "version": "0.1.0",
  "description": "Adds a Ctrl+Z this order button to food delivery order pages. Hackathon demo, not affiliated with any delivery app.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Ctrl+Z Eats" },
  "background": { "service_worker": "build/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.doordash.com/*"],
      "js": ["build/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.doordash.com/*",
    "http://localhost:8787/*",
    "https://ctrlz-eats.stalerole.workers.dev/*"
  ]
}
